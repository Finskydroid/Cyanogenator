#!/usr/bin/env bash
clear

echo -e "\033[36m##################################################################\033[0m"
echo -e "\033[36m ____                           ____                  _  __       \033[0m"      
echo -e "\033[36m/ ___> _   _ _ __   ___ _ __   / ___|   _  _  _ ____ (_)/ _|_   _ \033[0m"
echo -e "\033[36m\___ \| | | | '_ \ / _ \ '__> | |  | | | |/ \/ | '_ \| | |_| | | |\033[0m"
echo -e "\033[36m ___) | |_| | |_) |  __/ |    | |__| |_| | (_| | | | | |  _| |_| |\033[0m"
echo -e "\033[36m<____/ \__,_| .__/ \___|_|     \____\__, |\__,_|_| |_|_|_|  \__, |\033[0m"
echo -e "\033[36m            |_|                     |___/                   <___/ \033[0m"
echo -e "\033[36m                                                                  \033[0m"
echo -e "\033[36m##################################################################\033[0m"
echo -e "\033[36mA Official Cyanogenator tool for internal management and identify \033[0m"
echo -e "\033[36m                                                                  \033[0m"
echo -e "\033[36mDEVICES\033[0m"
devices=$(adb devices | awk 'NR > 1 && $2 == "device" {print $1}')

if [ -z "$devices" ]; then
    echo "NO AUTHORIZED DEVICE FOUND!"
    echo "Check USB debugging and ADB authorization."
    exit 1
fi

device_count=$(printf '%s\n' "$devices" | wc -l)

if [ "$device_count" -ne 1 ]; then
    echo "MULTIPLE DEVICES FOUND!"
    echo "Connect only one authorized device."
    exit 1
fi

echo "CONNECTED: $devices"

PS3="SUCy > "
select choice in "Device Info" "Partitions" "Root Check" "Enter Recovery" "Enter Download" "Reboot" "Exit"; do
            case "$choice" in
           "Device Info")
              echo "Device Info selected!"
              adb shell getprop
            ;;
        "Partitions")
            echo "Partitions selected"
            adb shell ls -l /dev/block/
            ;;
        "Root Check")
            echo "Root Check selected"
            echo "TRYING A ROOT..."
             if Root=$(adb shell su -c id | grep "root"); then
              echo "ROOT AVAILABLE!"
              echo "$Root"
            else
              echo "ROOT NOT FOUND, EXITING!"
              exit
            fi
            ;;
       "Enter Recovery")
            echo "Rebooting..."
               adb reboot recovery
            echo "DONE!"
          exit
        ;;
       "Enter Download")
            echo "Rebooting..."
               adb reboot download
            echo "DONE!"
          exit
        ;;
       "Reboot")
            echo "Rebooting..."
               adb reboot
            echo "DONE!"
          exit
        ;;
        "Exit")
            break
            ;;
        *)
            echo "INVALID OPTION, EXITING!"
            exit
            ;;
     esac
done
fi
